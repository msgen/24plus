# ---- Netlify (Site configuration > Environment variables). Blobs need no setup: Netlify provides them. ----
SESSION_SECRET=            # required: 32+ random chars (openssl rand -hex 32)
SITE_URL=https://24plus.ro
ADMIN_EMAIL=               # first start only: creates the admin if none exists
ADMIN_PASSWORD=            # first start only (10+ chars), then delete this variable
ADMIN_NAME=
STORAGE=netlify            # explicit; Netlify is also auto-detected

# Optional: e-mail each quote request (requests are always stored in the admin). A cPanel mailbox works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=contact@24plus.ro
MAIL_FROM=

# ---- Local development / Docker / VPS: leave STORAGE empty, data goes to DATA_DIR ----
DATA_DIR=./data            # JSON files + uploads; BACK THIS FOLDER UP
HOST=0.0.0.0
PORT=4321
