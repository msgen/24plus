---
import Base from '../../layouts/Base.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { getCategories, servicesIn } from '../../lib/content';
const categories = getCategories();
---
<Base title="Servicii" description="Toate serviciile 24 Plus Media: producție publicitară, printuri mari, print digital și obiecte promoționale.">
  <div class="container-x pt-14">
    <p class="eyebrow">Servicii</p>
    <h1 class="display mt-3 text-5xl sm:text-7xl">Tot ce ai nevoie pentru <span class="text-brand">vizibilitate</span></h1>
    {categories.map((c, i) => (
      <section class="mt-16 border-t-2 border-ink pt-8">
        <div class="flex items-end justify-between gap-4">
          <div class="flex items-baseline gap-4"><span class="display text-5xl text-brand">{String(i + 1).padStart(2, '0')}</span><div><h2 class="text-3xl">{c.title}</h2><p class="mt-1 text-mute">{c.blurb}</p></div></div>
          <a href={`/servicii/${c.slug}`} class="hidden text-sm font-extrabold hover:text-brand-dark sm:block">Vezi categoria →</a>
        </div>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {servicesIn(c.slug).map((s) => <ServiceCard service={s} />)}
        </div>
      </section>
    ))}
  </div>
</Base>
