---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import ServiceCard from '../../../components/ServiceCard.astro';
import { getCategories, servicesIn } from '../../../lib/content';
const c = getCategories().find((x) => x.slug === Astro.params.category);
if (!c) return Astro.rewrite('/404');
---
<Base title={c.title} description={c.blurb}>
  <PageHero title={c.title} lead={c.blurb} crumbs={[{ href: '/servicii', label: 'Servicii' }, { label: c.title }]} />
  <div class="container-x py-16 lg:py-20">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {servicesIn(c.slug).map((s) => <ServiceCard service={s} />)}
    </div>
  </div>
</Base>
