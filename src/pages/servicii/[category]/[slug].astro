---
import Base from '../../../layouts/Base.astro';
import Gallery from '../../../components/Gallery.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import ServiceCard from '../../../components/ServiceCard.astro';
import { serviceBySlug, categoryBySlug, projectsFor, servicesIn, getSite } from '../../../lib/content';
const site = getSite();
const s = serviceBySlug(Astro.params.slug!);
if (!s || s.category !== Astro.params.category) return Astro.rewrite('/404');
const cat = categoryBySlug(s.category);
const gallery = projectsFor(s.slug);
const related = servicesIn(s.category).filter((x) => x.slug !== s.slug).slice(0, 3);
---
<Base title={s.title} description={s.excerpt} image={gallery[0]?.full}>
  <div class="container-x pt-14">
    <nav class="text-sm font-semibold text-mute" aria-label="Breadcrumb">
      <a href="/servicii" class="hover:text-ink hover:underline">Servicii</a> / <a href={`/servicii/${cat.slug}`} class="hover:text-ink hover:underline">{cat.title}</a> / {s.title}
    </nav>
    <div class="mt-6 grid gap-10 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <h1 class="display text-5xl sm:text-7xl">{s.title}</h1>
        <div class="mt-8 space-y-4 text-lg text-mute">{s.paragraphs.map((p) => <p>{p}</p>)}</div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#oferta" class="btn btn-primary">Cere ofertă →</a>
          <a href={site.phoneHref} class="btn btn-dark">{site.phone}</a>
        </div>
      </div>
      {gallery[0] && <img src={gallery[0].full} alt={s.title} width="1600" class="aspect-[4/3] w-full border-2 border-ink object-cover" fetchpriority="high" />}
    </div>

    {gallery.length > 0 && (
      <section class="mt-16 border-t-2 border-ink pt-8">
        <h2 class="display text-3xl sm:text-5xl">Lucrări <span class="text-brand">realizate</span></h2>
        <div class="mt-6"><Gallery items={gallery} alt={s.title} /></div>
      </section>
    )}

    <section id="oferta" class="mt-16 grid scroll-mt-24 gap-8 border-t-2 border-ink pt-8 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Ofertă</p>
        <h2 class="display mt-2 text-4xl sm:text-5xl">Spune-ne ce ai nevoie</h2>
        <p class="mt-4 text-mute">Completează formularul și revenim cu o ofertă. Preferi telefonul? Sună la <a class="font-extrabold text-brand-dark" href={site.phoneHref}>{site.phone}</a>.</p>
      </div>
      <QuoteForm service={s.slug} />
    </section>

    {related.length > 0 && (
      <section class="mt-16">
        <h2 class="display text-3xl sm:text-5xl">Vezi și</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-3">{related.map((r) => <ServiceCard service={r} />)}</div>
      </section>
    )}
  </div>
</Base>
