---
import Base from '../../../layouts/Base.astro';
import Gallery from '../../../components/Gallery.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import ServiceCard from '../../../components/ServiceCard.astro';
import { serviceBySlug, categoryBySlug, projectsFor, servicesIn, getSite } from '../../../lib/content';
const site = getSite();
const s = serviceBySlug(Astro.params.slug!);
if (!s || s.category !== Astro.params.category) return Astro.rewrite('/404');
const cat = categoryBySlug(s.category);
const gallery = projectsFor(s.slug);
const related = servicesIn(s.category).filter((x) => x.slug !== s.slug).slice(0, 3);
---
<Base title={s.title} description={s.excerpt} image={gallery[0]?.full}>
  <section class="bg-ink text-paper">
    <div class="container-x grid items-center gap-10 py-14 lg:grid-cols-[1.1fr_1fr] lg:py-20">
      <div>
        <nav class="text-sm font-semibold text-fog" aria-label="Breadcrumb">
          <a href="/servicii" class="hover:text-brand">Servicii</a> / <a href={`/servicii/${cat.slug}`} class="hover:text-brand">{cat.title}</a> / <span class="text-paper">{s.title}</span>
        </nav>
        <h1 class="display mt-6 text-[3.25rem] sm:text-7xl lg:text-8xl">{s.title}</h1>
        {s.excerpt && <p class="mt-6 max-w-xl text-lg leading-relaxed text-[#c9ccc3]">{s.excerpt}</p>}
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#oferta" class="btn btn-primary">Cere ofertă ↗</a>
          <a href={site.phoneHref} class="btn btn-ghost">{site.phone}</a>
        </div>
      </div>
      {gallery[0] && <img src={gallery[0].full} alt={gallery[0].alt || s.title} width="1600" class="aspect-[4/3] w-full rounded-2xl object-cover shadow-[0_40px_80px_rgba(0,0,0,0.5)]" fetchpriority="high" />}
    </div>
  </section>

  <div class="container-x py-16 lg:py-20">
    {s.paragraphs.length > 0 && (
      <section class="grid items-start gap-8 lg:grid-cols-[1fr_2fr]">
        <p class="eyebrow">Despre serviciu</p>
        <div class="space-y-4 text-lg leading-relaxed text-mute">{s.paragraphs.map((p) => <p>{p}</p>)}</div>
      </section>
    )}

    {gallery.length > 0 && (
      <section class="mt-16 border-t border-line pt-10">
        <h2 class="display text-4xl sm:text-5xl">Lucrări <span class="text-brand-dark">realizate.</span></h2>
        <div class="mt-8"><Gallery items={gallery} alt={s.title} /></div>
      </section>
    )}

    <section id="oferta" class="mt-16 grid scroll-mt-24 gap-8 border-t border-line pt-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Ofertă</p>
        <h2 class="display mt-4 text-4xl sm:text-5xl">Spune-ne ce ai nevoie.</h2>
        <p class="mt-4 text-mute">Completează formularul și revenim cu o ofertă. Preferi telefonul? Sună la <a class="font-extrabold text-brand-dark" href={site.phoneHref}>{site.phone}</a>.</p>
      </div>
      <QuoteForm service={s.slug} />
    </section>

    {related.length > 0 && (
      <section class="mt-16 border-t border-line pt-10">
        <h2 class="display text-4xl sm:text-5xl">Vezi și</h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-3">{related.map((r) => <ServiceCard service={r} />)}</div>
      </section>
    )}
  </div>
</Base>
