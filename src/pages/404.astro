---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Pagina nu a fost găsită" noindex>
  <PageHero eyebrow="Eroare 404" title="Pagina" accent="nu există." lead="Poate a fost mutată. Încearcă de la prima pagină sau din lista de servicii.">
    <div class="mt-8 flex flex-wrap gap-3"><a href="/" class="btn btn-dark">Prima pagină →</a><a href="/servicii" class="btn btn-outline">Servicii</a></div>
  </PageHero>
  <div class="py-10"></div>
</Base>
