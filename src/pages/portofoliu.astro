---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Lightbox from '../components/Lightbox.astro';
import { getProjects, getServices } from '../lib/content';
const projects = getProjects();
const filters = getServices().filter((s) => projects.some((p) => p.service === s.slug));
const titles = new Map(getServices().map((s) => [s.slug, s.title]));
const altFor = (p: (typeof projects)[number]) => p.alt || `Lucrare ${titles.get(p.service) ?? p.service.replace(/-/g, ' ')}`;
---
<Base title="Portofoliu" description="Lucrări realizate de 24 Plus Media: litere volumetrice, firme luminoase, personalizări auto, vitrine și multe altele.">
  <PageHero eyebrow="Portofoliu" title="Lucrările" accent="noastre.">
    <div class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filtrează lucrările">
      <button class="filter btn btn-sm rounded-full border-[1.5px] border-ink aria-pressed:border-brand aria-pressed:bg-brand aria-pressed:text-on-green hover:bg-card" data-filter="all" aria-pressed="true">Toate</button>
      {filters.map((s) => <button class="filter btn btn-sm rounded-full border-[1.5px] border-ink aria-pressed:border-brand aria-pressed:bg-brand aria-pressed:text-on-green hover:bg-card" data-filter={s.slug} aria-pressed="false">{s.title}</button>)}
    </div>
  </PageHero>
  <div class="container-x py-12 lg:py-16">
    <div id="grid">
      <ul class="columns-2 gap-3 sm:columns-3 [&>li]:mb-3">
        {projects.map((p) => (
          <li class="break-inside-avoid" data-service={p.service}>
            <button type="button" data-full={p.full} data-alt={altFor(p)} class="block w-full overflow-hidden rounded-xl bg-line">
              <img src={p.thumb} alt={altFor(p)} loading="lazy" width="640" height="480" class="w-full transition duration-500 hover:scale-105" />
            </button>
          </li>
        ))}
      </ul>
    </div>
    <Lightbox />
  </div>
</Base>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  buttons.forEach((btn) => btn.addEventListener('click', () => {
    const f = btn.dataset.filter;
    buttons.forEach((b) => {
      const on = b === btn;
      b.setAttribute('aria-pressed', String(on));
    });
    document.querySelectorAll<HTMLElement>('#grid li').forEach((li) => { li.hidden = f !== 'all' && li.dataset.service !== f; });
  }));
</script>
