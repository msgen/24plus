---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { getCategories, serviceBySlug, getClients, getProjects, getTestimonials, getSite } from '../lib/content';
const site = getSite();
const categories = getCategories();
const clients = getClients();
const testimonials = getTestimonials();
const all = getProjects();
const byId = (id: string) => all.find((p) => p.id === id);
const promoted = all.filter((p) => p.featured);
const pick = (ids: string[], n: number) =>
  (promoted.length >= n ? promoted : [...ids.map(byId), ...all].filter((p) => !!p)).filter((p, i, a) => a.indexOf(p) === i).slice(0, n);

// Photos promoted in the admin ("show on home page") win; otherwise a hand-picked default set.
const heroTiles = pick(['litere-volumetrice-16', 'litere-volumetrice-02', 'personalizari-auto-08'], 3);
const works = pick(['litere-volumetrice-12', 'personalizari-auto-05', 'litere-volumetrice-08', 'litere-volumetrice-22', 'casete-luminoase-06', 'mese-candybar-02'], 6);
const day = byId('litere-volumetrice-15');
const night = byId('litere-volumetrice-16');

const featured = ['litere-volumetrice', 'casete-luminoase', 'personalizari-auto', 'decorari-geamuri-si-vitrine', 'totem', 'mese-candybar']
  .map(serviceBySlug).filter((s) => !!s);
const caption = (service: string) => serviceBySlug(service)?.title ?? service.replace(/-/g, ' ');

// The hero title is editable; its last word is set in green.
const words = site.heroTitle.trim().split(/\s+/);
const titleEnd = words.length > 1 ? words.pop()! : '';
const titleStart = words.join(' ');
const comma = titleStart.indexOf(',');

const process = [
  ['Design și consiliere', 'Ne spui ce vrei să obții. Propunem soluția și materialele.'],
  ['Producție', 'Materiale de calitate, la prețuri corecte.'],
  ['Asamblare și montaj', 'Montăm noi, la locul lucrării.'],
  ['Logistică', 'Timpi de livrare reduși la minimum.'],
];
---
<Base title={site.name} image={heroTiles[0]?.full}>
  <section class="bg-paper">
    <div class="container-x pb-14 pt-12 lg:pt-20">
      <p class="eyebrow">Producție publicitară · Râmnicu Vâlcea</p>
      <div class="mt-5 flex flex-wrap items-end justify-between gap-8">
        <h1 class="display min-w-0 flex-[1_1_40rem] text-[3.5rem] sm:text-8xl xl:text-[7rem]">
          {comma > 0 ? <>{titleStart.slice(0, comma + 1)}<br />{titleStart.slice(comma + 1).trim()}</> : titleStart}{titleEnd && <> <span class="text-brand-mid">{titleEnd}</span></>}
        </h1>
        <div class="min-w-0 flex-[0_1_22rem]">
          <p class="text-[17px] leading-relaxed text-mute">{site.heroSubtitle}</p>
          <div class="mt-6 flex flex-wrap gap-2.5">
            <a href="#oferta" class="btn btn-dark">Cere ofertă →</a>
            <a href="/portofoliu" class="btn btn-outline">Portofoliu</a>
          </div>
        </div>
      </div>
      {heroTiles.length === 3 && (
        <ul class="mt-12 grid gap-3.5 md:h-[540px] md:grid-cols-[2fr_1fr] md:grid-rows-2">
          {heroTiles.map((p, i) => (
            <li class:list={['group relative overflow-hidden rounded-2xl bg-ink', i === 0 ? 'h-[320px] md:row-span-2 md:h-auto' : 'h-[240px] md:h-auto']}>
              <a href="/portofoliu" class="block h-full">
                <img src={i === 0 ? p.full : p.thumb} alt={p.alt || caption(p.service)} fetchpriority={i === 0 ? 'high' : undefined} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                <span class="absolute bottom-5 left-0 bg-brand px-4 py-2 text-xs font-extrabold uppercase tracking-[0.06em] text-on-green">{caption(p.service)}</span>
                {i === 0 && (
                  <span class="absolute right-4 top-4 flex flex-col rounded-xl bg-ink px-4 py-3 text-paper">
                    <b class="font-display text-3xl font-extrabold leading-none text-brand [font-stretch:78%]">24+</b>
                    <span class="mt-1 text-xs font-bold">design · producție · montaj</span>
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  {clients.length > 0 && (
    <section class="border-y border-line bg-paper" aria-labelledby="clienti-titlu">
      <div class="container-x flex flex-wrap items-center gap-x-7 gap-y-3 py-6">
        <h2 id="clienti-titlu" class="text-xs font-extrabold uppercase tracking-[0.16em] text-mute">Au lucrat cu noi</h2>
        <ul class="flex flex-wrap items-center gap-x-3 gap-y-1 font-display text-[1.375rem] font-bold text-[#4a483f] [font-stretch:78%]">
          {clients.map((c, i) => (
            <li class="flex items-center gap-3">{i > 0 && <span aria-hidden="true" class="text-brand">•</span>}{c.logo ? <img src={c.logo} alt={c.name} loading="lazy" class="h-8 w-auto" /> : c.name}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="bg-paper">
    <div class="container-x py-20 lg:py-28">
      <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-end">
        <h2 class="display text-5xl sm:text-6xl">Patru categorii,<br />un singur partener.</h2>
        <div class="space-y-4 leading-relaxed text-mute">{site.intro.map((p) => <p>{p}</p>)}</div>
      </div>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map((c, i) => (
          <li>
            <a href={`/servicii/${c.slug}`} class="group flex h-full min-h-[300px] flex-col gap-4 rounded-2xl bg-card p-6 transition hover:-translate-y-0.5 hover:bg-[#e3e1d8]">
              <span class="display text-6xl text-brand-mid">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="font-display text-[1.65rem] font-extrabold leading-tight [font-stretch:85%]">{c.title}</h3>
              <p class="flex-1 text-sm leading-relaxed text-mute">{c.blurb}</p>
              <span aria-hidden="true" class="grid size-10 place-items-center rounded-full bg-ink text-paper transition group-hover:bg-brand group-hover:text-on-green">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-t border-line bg-paper">
    <div class="container-x py-20 lg:py-28">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="display text-5xl sm:text-6xl">Servicii <span class="text-brand-mid">populare.</span></h2>
        <a href="/servicii" class="btn btn-outline">Toate serviciile →</a>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((s, i) => <ServiceCard service={s!} n={i + 1} />)}
      </div>
    </div>
  </section>

  {works.length > 0 && (
    <section id="lucrari" class="scroll-mt-20 bg-ink text-paper">
      <div class="container-x py-20 lg:py-28">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 class="display text-5xl sm:text-6xl">Lucrări <span class="text-brand">recente.</span></h2>
          <a href="/portofoliu" class="btn btn-ghost">Tot portofoliul →</a>
        </div>
        <ul class="mt-11 grid gap-x-5 gap-y-7 sm:grid-cols-2 lg:grid-cols-3">
          {works.map((p) => (
            <li>
              <a href="/portofoliu" class="group block">
                <div class="h-[260px] overflow-hidden rounded-2xl bg-ink-2">
                  <img src={p.thumb} alt={p.alt || caption(p.service)} loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                </div>
                <p class="mt-3 text-[15px]"><b>{caption(p.service)}</b>{p.alt && <span class="text-fog"> · {p.alt}</span>}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {day && night && (
    <section class="bg-paper">
      <div class="container-x py-20 lg:py-28">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 class="display text-5xl sm:text-6xl">Aceeași firmă,<br />zi și noapte.</h2>
          <p class="max-w-md leading-relaxed text-mute">Popasul Trei Stejari: litere volumetrice care se citesc ziua și se aprind seara. Design, producție și montaj, de la noi.</p>
        </div>
        <div class="mt-10 grid gap-3.5 md:grid-cols-2">
          <figure class="relative h-[300px] overflow-hidden rounded-2xl sm:h-[380px]">
            <img src={day.full} alt="Popasul Trei Stejari, ziua" loading="lazy" class="h-full w-full object-cover" />
            <figcaption class="absolute left-4 top-4 rounded-lg bg-paper px-3 py-1.5 text-xs font-extrabold tracking-[0.12em]">ZIUA</figcaption>
          </figure>
          <figure class="relative h-[300px] overflow-hidden rounded-2xl sm:h-[380px]">
            <img src={night.full} alt="Popasul Trei Stejari, noaptea, cu literele aprinse" loading="lazy" class="h-full w-full object-cover" />
            <figcaption class="absolute left-4 top-4 rounded-lg bg-ink px-3 py-1.5 text-xs font-extrabold tracking-[0.12em] text-paper">NOAPTEA</figcaption>
          </figure>
        </div>
      </div>
    </section>
  )}

  <section class="border-t border-line bg-paper">
    <div class="container-x py-20 lg:py-28">
      <h2 class="display text-5xl sm:text-6xl">Cum lucrăm.</h2>
      <ol class="mt-12 grid gap-7 sm:grid-cols-2 lg:grid-cols-4">
        {process.map(([t, d], i) => (
          <li class="border-t-2 border-ink pt-6">
            <span class="grid size-11 place-items-center rounded-full bg-brand font-extrabold text-on-green">{i + 1}</span>
            <h3 class="mt-4 font-display text-2xl font-extrabold [font-stretch:85%]">{t}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-mute">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="border-t border-line bg-paper">
      <div class="container-x py-20 lg:py-28">
        <h2 class="display text-5xl sm:text-6xl">Ce spun <span class="text-brand-mid">clienții.</span></h2>
        <ul class="mt-10 grid gap-5 md:grid-cols-3">
          {testimonials.map((t) => (
            <li class="card p-6">
              <p class="text-lg font-semibold">„{t.text}”</p>
              <p class="mt-4 text-sm font-extrabold text-brand-dark">{t.author}{t.company ? `, ${t.company}` : ''}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section id="oferta" class="scroll-mt-20 bg-brand text-on-green">
    <div class="container-x grid items-center gap-12 py-20 lg:grid-cols-[1.1fr_1fr] lg:py-24">
      <div>
        <h2 class="display text-6xl sm:text-7xl lg:text-[5.5rem]">Hai să discutăm<br />proiectul tău.</h2>
        <p class="mt-6 max-w-md text-[17px] font-medium leading-relaxed">Sună-ne sau lasă-ne datele și te contactăm noi.</p>
        <p class="mt-5 flex flex-wrap gap-x-6 gap-y-2 font-display text-[1.75rem] font-extrabold [font-stretch:85%]">
          <a href={site.phoneHref} class="underline decoration-2 underline-offset-4 hover:decoration-transparent">{site.phone}</a>
          <a href={`mailto:${site.email}`} class="underline decoration-2 underline-offset-4 hover:decoration-transparent">{site.email}</a>
        </p>
      </div>
      <QuoteForm />
    </div>
  </section>
</Base>
