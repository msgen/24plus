---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { getCategories, servicesIn, serviceBySlug, getClients, getProjects, getTestimonials, getSite, projectsFor } from '../lib/content';
const site = getSite();
const categories = getCategories();
const clients = getClients();
const testimonials = getTestimonials();
const all = getProjects();
const promoted = all.filter((p) => p.featured);
const strip = (promoted.length >= 4 ? promoted : all.filter((_, i) => i % 3 === 0)).slice(0, 8);
const featured = ['litere-volumetrice', 'casete-luminoase', 'personalizari-auto', 'decorari-geamuri-si-vitrine', 'totem', 'mese-candybar']
  .map(serviceBySlug).filter((s) => !!s);
const heroPhoto = promoted[0]?.full ?? projectsFor('casete-luminoase')[0]?.full ?? '/img/hero.webp';
const trio = ['litere-volumetrice', 'personalizari-auto', 'mese-candybar']
  .map((slug) => ({ s: serviceBySlug(slug), p: projectsFor(slug)[1] ?? projectsFor(slug)[0] })).filter((x) => x.s && x.p);
---
<Base title={site.name} image={heroPhoto}>
  <section class="grid border-b-2 border-ink lg:min-h-[640px] lg:grid-cols-[5fr_6fr]">
    <div class="flex flex-col justify-between gap-12 bg-brand px-4 py-12 sm:px-8 lg:px-12 lg:py-14">
      <p class="eyebrow text-ink">Producție publicitară<br />Râmnicu Vâlcea</p>
      <h1 class="display text-[3.4rem] sm:text-7xl xl:text-[5.4rem]">{site.heroTitle}</h1>
      <div>
        <p class="max-w-md text-lg font-semibold">{site.heroSubtitle}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/contact#oferta" class="btn btn-dark">Cere ofertă →</a>
          <a href="/portofoliu" class="btn border-2 border-ink hover:bg-ink hover:text-white">Vezi portofoliul</a>
        </div>
      </div>
    </div>
    <div class="relative min-h-[320px] bg-ink">
      <img src={heroPhoto} alt="" class="absolute inset-0 h-full w-full object-cover" fetchpriority="high" />
    </div>
  </section>

  <section class="grid border-b-2 border-ink sm:grid-cols-2 lg:grid-cols-4">
    {categories.map((c, i) => (
      <a href={`/servicii/${c.slug}`} class="group flex min-h-[220px] flex-col justify-between border-ink p-8 transition hover:bg-brand max-sm:border-b-2 sm:border-b-2 sm:odd:border-r-2 lg:border-b-0 lg:border-r-2 lg:last:border-r-0">
        <span class="display text-6xl text-brand group-hover:text-ink">{String(i + 1).padStart(2, '0')}</span>
        <div>
          <h2 class="text-2xl leading-tight">{c.title}</h2>
          <p class="mt-1 text-sm text-mute group-hover:text-ink">{c.blurb}</p>
        </div>
      </a>
    ))}
  </section>

  <section class="container-x mt-24">
    <h2 class="display text-5xl sm:text-7xl">Soluții complete,<br />la prețuri <span class="text-brand">corecte.</span></h2>
    <div class="mt-10 text-lg text-mute md:columns-2 md:gap-12 [&>p]:mb-5">
      {site.intro.map((p) => <p>{p}</p>)}
    </div>
  </section>

  {trio.length === 3 && (
    <section class="mt-16 grid border-y-2 border-ink md:grid-cols-[1.4fr_1fr_1fr]">
      {trio.map(({ s, p }, i) => (
        <a href={`/servicii/${s!.category}/${s!.slug}`} class="group relative block h-[420px] overflow-hidden border-ink max-md:border-b-2 md:border-r-2 md:last:border-r-0">
          <img src={p!.full} alt={s!.title} loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
          <span class:list={['absolute bottom-0 left-0 px-4 py-2.5 text-sm font-bold', i === 1 ? 'bg-brand text-ink' : 'bg-ink text-white']}>{s!.title}</span>
        </a>
      ))}
    </section>
  )}

  <section class="container-x mt-24">
    <div class="flex items-end justify-between gap-4">
      <h2 class="display text-4xl sm:text-6xl">Servicii populare</h2>
      <a href="/servicii" class="hidden text-sm font-extrabold hover:text-brand-dark sm:block">Toate serviciile →</a>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((s) => <ServiceCard service={s!} />)}
    </div>
  </section>

  {strip.length > 0 && (
    <section class="mt-24 border-y-2 border-ink bg-ink py-16 text-white">
      <div class="container-x">
        <div class="flex items-end justify-between gap-4">
          <h2 class="display text-4xl sm:text-6xl">Lucrări <span class="text-brand">recente</span></h2>
          <a href="/portofoliu" class="text-sm font-extrabold text-brand hover:underline">Vezi tot →</a>
        </div>
        <ul class="mt-10 grid grid-cols-2 gap-px bg-white/30 sm:grid-cols-4">
          {strip.map((p) => <li class="bg-ink"><a href="/portofoliu"><img src={p.thumb} alt={p.alt || 'Lucrare 24 Plus Media'} loading="lazy" width="640" height="480" class="aspect-square w-full object-cover transition duration-500 hover:opacity-80" /></a></li>)}
        </ul>
      </div>
    </section>
  )}

  {clients.length > 0 && (
    <section class="container-x mt-24">
      <h2 class="display text-4xl sm:text-6xl">Au lucrat cu noi</h2>
      <ul class="mt-8 flex flex-wrap border-l-2 border-t-2 border-ink">
        {clients.map((c) => (
          <li class="flex min-h-16 grow items-center justify-center border-b-2 border-r-2 border-ink px-6 py-3 text-center text-sm font-extrabold">
            {c.logo ? <img src={c.logo} alt={c.name} loading="lazy" class="h-9 w-auto" /> : c.name}
          </li>
        ))}
      </ul>
    </section>
  )}

  {testimonials.length > 0 && (
    <section class="container-x mt-24">
      <h2 class="display text-4xl sm:text-6xl">Ce spun <span class="text-brand">clienții</span></h2>
      <ul class="mt-8 grid gap-6 md:grid-cols-3">
        {testimonials.map((t) => (
          <li class="border-2 border-ink p-6">
            <p class="text-lg font-semibold">„{t.text}”</p>
            <p class="mt-4 text-sm font-extrabold text-brand-dark">{t.author}{t.company ? `, ${t.company}` : ''}</p>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
