---
import Admin from '../../layouts/Admin.astro';
import { login, startSession, tooMany, currentUser, ensureAdmin } from '../../lib/auth';
import { msg } from '../../lib/admin';
import { read } from '../../lib/store';

await ensureAdmin();
if (await currentUser(Astro.cookies)) return Astro.redirect('/admin');
const noUsers = (await read('users')).length === 0;
if (Astro.request.method === 'POST') {
  if (await tooMany(`login:${Astro.clientAddress}`, 8, 15 * 60_000)) return Astro.redirect(msg('/admin/login', 'Prea multe încercări. Încearcă peste 15 minute.', 'err'));
  const f = await Astro.request.formData();
  const user = await login(String(f.get('email') ?? ''), String(f.get('password') ?? ''));
  if (!user) return Astro.redirect(msg('/admin/login', 'E-mail sau parolă greșite.', 'err'));
  // Secure cookie only when the visitor really is on HTTPS (directly or via a proxy), so http://localhost works too.
  const https = process.env.FORCE_HTTPS === '1' || Astro.url.protocol === 'https:' || Astro.request.headers.get('x-forwarded-proto') === 'https';
  startSession(Astro.cookies, user, https);
  return Astro.redirect('/admin');
}
---
<Admin title="Autentificare">
  <form method="post" class="card max-w-sm space-y-4">
    <label class="label">E-mail<input class="field" name="email" type="email" autocomplete="username" required autofocus /></label>
    <label class="label">Parolă<input class="field" name="password" type="password" autocomplete="current-password" required /></label>
    <button class="btn btn-primary w-full">Intră</button>
  </form>
  {noUsers && <p class="mt-4 max-w-sm text-sm text-mute">Nu există niciun utilizator. Creează unul cu <code>npm run user:add</code> pe server.</p>}
</Admin>
