---
import { cover, serviceUrl, type Service } from '../lib/content';
const { service } = Astro.props as { service: Service };
const img = cover(service.slug);
---
<a href={serviceUrl(service)} class="group relative block border-2 border-ink bg-white">
  <div class="aspect-[4/3] overflow-hidden border-b-2 border-ink bg-brand">
    {img
      ? <img src={img} alt={service.title} loading="lazy" width="640" height="480" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
      : <div class="grid h-full place-items-center text-6xl font-extrabold text-ink">24+</div>}
  </div>
  <div class="p-5 transition group-hover:bg-brand">
    <h3 class="flex items-start justify-between gap-3 text-lg leading-tight">{service.title}<span aria-hidden="true">→</span></h3>
    <p class="mt-1 text-sm text-mute group-hover:text-ink">{service.excerpt}</p>
  </div>
</a>
