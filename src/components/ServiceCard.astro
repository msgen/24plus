---
import { cover, serviceUrl, type Service } from '../lib/content';
const { service } = Astro.props as { service: Service };
const img = cover(service.slug);
---
<a href={serviceUrl(service)} class="group block overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-line transition hover:-translate-y-1 hover:shadow-lg">
  <div class="aspect-[4/3] overflow-hidden bg-brand-tint">
    {img
      ? <img src={img} alt={service.title} loading="lazy" width="640" height="480" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
      : <div class="grid h-full place-items-center text-6xl font-extrabold text-brand/40">24+</div>}
  </div>
  <div class="p-5">
    <h3 class="text-lg">{service.title}</h3>
    <p class="mt-1 text-sm text-mute">{service.excerpt}</p>
  </div>
</a>
