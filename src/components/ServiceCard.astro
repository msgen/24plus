---
import { cover, serviceUrl, type Service } from '../lib/content';
const { service, n } = Astro.props as { service: Service; n?: number };
const img = cover(service.slug);
---
<a href={serviceUrl(service)} class="group block overflow-hidden rounded-2xl bg-card transition hover:-translate-y-0.5 hover:bg-[#e3e1d8]">
  <div class="relative aspect-[3/2] overflow-hidden bg-ink">
    {img
      ? <img src={img} alt={service.title} loading="lazy" width="640" height="480" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
      : <div class="grid h-full place-items-center font-display text-7xl font-extrabold text-brand [font-stretch:78%]">24+</div>}
    {n && <span class="absolute left-0 top-4 bg-brand px-3 py-1.5 text-xs font-extrabold text-on-green">{String(n).padStart(2, '0')}</span>}
  </div>
  <div class="flex items-end justify-between gap-4 p-5 sm:p-6">
    <div>
      <h3 class="font-display text-[1.6rem] font-extrabold leading-tight [font-stretch:85%]">{service.title}</h3>
      {service.excerpt && <p class="mt-2 text-sm leading-relaxed text-mute">{service.excerpt}</p>}
    </div>
    <span aria-hidden="true" class="grid size-10 shrink-0 place-items-center rounded-full bg-ink text-paper transition group-hover:bg-brand group-hover:text-on-green">→</span>
  </div>
</a>
