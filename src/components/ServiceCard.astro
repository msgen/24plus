---
import { cover, serviceUrl, type Service } from '../lib/content';
const { service, n } = Astro.props as { service: Service; n?: number };
const img = cover(service.slug);
---
<a href={serviceUrl(service)} class="group block overflow-hidden rounded-xl border border-line bg-card transition hover:border-brand">
  <div class="relative aspect-[3/2] overflow-hidden bg-ink">
    {img
      ? <img src={img} alt={service.title} loading="lazy" width="640" height="480" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
      : <div class="grid h-full place-items-center font-display text-7xl font-bold text-brand">24+</div>}
    {n && <span class="absolute left-3 top-3 rounded-md bg-ink px-2.5 py-1 text-xs font-extrabold text-brand">{String(n).padStart(2, '0')}</span>}
  </div>
  <div class="p-5 sm:p-6">
    <h3 class="font-display text-[1.65rem] font-bold leading-tight">{service.title}</h3>
    {service.excerpt && <p class="mt-2 text-sm leading-relaxed text-mute">{service.excerpt}</p>}
    <p class="mt-3.5 text-sm font-extrabold text-brand-dark">Detalii <span aria-hidden="true" class="inline-block transition group-hover:translate-x-1">→</span></p>
  </div>
</a>
