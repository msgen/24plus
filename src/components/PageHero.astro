---
// Dark title band at the top of inner pages. `accent` is the green tail of the title.
interface Props { title: string; accent?: string; eyebrow?: string; lead?: string; crumbs?: { href?: string; label: string }[] }
const { title, accent, eyebrow, lead, crumbs = [] } = Astro.props;
---
<section class="bg-ink text-paper">
  <div class="container-x py-14 lg:py-20">
    {crumbs.length > 0 && (
      <nav class="mb-6 text-sm font-semibold text-fog" aria-label="Breadcrumb">
        {crumbs.map((c, i) => <>{i > 0 && <span aria-hidden="true"> / </span>}{c.href ? <a href={c.href} class="hover:text-brand">{c.label}</a> : <span class="text-paper">{c.label}</span>}</>)}
      </nav>
    )}
    {eyebrow && <p class="eyebrow eyebrow-light">{eyebrow}</p>}
    <h1 class="display mt-4 text-[3.25rem] sm:text-7xl lg:text-8xl">{title}{accent && <> <span class="text-brand">{accent}</span></>}</h1>
    {lead && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[#c9ccc3]">{lead}</p>}
    <slot />
  </div>
</section>
