---
import { getCategories, getSite } from '../lib/content';
const categories = getCategories();
const site = getSite();
const path = Astro.url.pathname;
// The home page and the contact page carry their own quote section.
const showCta = path !== '/' && !path.startsWith('/contact');
---
{showCta && (
  <section class="bg-brand text-on-green">
    <div class="container-x flex flex-wrap items-end justify-between gap-8 py-16 lg:py-20">
      <h2 class="display text-5xl sm:text-6xl lg:text-7xl">Hai să discutăm<br />proiectul tău.</h2>
      <div class="flex flex-wrap gap-3">
        <a href="/contact#oferta" class="btn btn-dark">Cere ofertă →</a>
        <a href={site.phoneHref} class="btn border-[1.5px] border-on-green hover:bg-on-green hover:text-paper">{site.phone}</a>
      </div>
    </div>
  </section>
)}
<footer class="bg-ink text-paper">
  <div class="container-x pb-8 pt-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <img src="/logo.webp" alt="24 Plus Media" width="440" height="271" class="h-16 w-auto rounded-lg" loading="lazy" />
        <p class="mt-4 text-sm leading-relaxed text-fog">Producție publicitară, de la design la montaj.</p>
      </div>
      <div>
        <h3 class="text-xs font-extrabold uppercase tracking-[0.16em] text-brand">Servicii</h3>
        <ul class="mt-3.5 space-y-2.5 text-sm text-[#e4e1d8]">
          {categories.map((c) => <li><a class="hover:text-brand" href={`/servicii/${c.slug}`}>{c.title}</a></li>)}
        </ul>
      </div>
      <div>
        <h3 class="text-xs font-extrabold uppercase tracking-[0.16em] text-brand">Companie</h3>
        <ul class="mt-3.5 space-y-2.5 text-sm text-[#e4e1d8]">
          <li><a class="hover:text-brand" href="/portofoliu">Portofoliu</a></li>
          <li><a class="hover:text-brand" href="/clienti">Clienți</a></li>
          <li><a class="hover:text-brand" href="/contact">Contact</a></li>
          <li><a class="hover:text-brand" href="/politica-confidentialitate">Confidențialitate</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-xs font-extrabold uppercase tracking-[0.16em] text-brand">Contact</h3>
        <address class="mt-3.5 space-y-2.5 text-sm not-italic text-[#e4e1d8]">
          <p>{site.address}</p>
          <p><a class="hover:text-brand" href={site.phoneHref}>{site.phone}</a></p>
          <p><a class="hover:text-brand" href={`mailto:${site.email}`}>{site.email}</a></p>
          {site.facebook && <p><a class="hover:text-brand" href={site.facebook} rel="noopener" target="_blank">Facebook</a></p>}
        </address>
      </div>
    </div>
    <p class="mt-12 border-t border-[#47463f] pt-5 text-xs text-[#a9a69c]">© {new Date().getFullYear()} {site.name}. Toate drepturile rezervate.</p>
  </div>
</footer>
