---
import Lightbox from './Lightbox.astro';
import type { Project } from '../lib/content';
const { items, alt } = Astro.props as { items: Project[]; alt: string };
---
<ul class="columns-2 gap-3 sm:columns-3 [&>li]:mb-3">
  {items.map((p, i) => (
    <li class="break-inside-avoid">
      <button type="button" data-full={p.full} data-alt={p.alt || `${alt} ${i + 1}`} class="block w-full overflow-hidden rounded-xl bg-line">
        <img src={p.thumb} alt={p.alt || `${alt} ${i + 1}`} loading="lazy" width="640" height="480" class="w-full transition duration-500 hover:scale-105" />
      </button>
    </li>
  ))}
</ul>
<Lightbox />
