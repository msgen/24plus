---
import { getCategories, servicesIn, serviceUrl, getSite } from '../lib/content';
const categories = getCategories();
const site = getSite();
const path = Astro.url.pathname;
const links = [{ href: '/portofoliu', label: 'Portofoliu' }, { href: '/clienti', label: 'Clienți' }, { href: '/contact', label: 'Contact' }];
---
<header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur">
  <div class="container-x flex h-[78px] items-center justify-between gap-6">
    <a href="/" class="flex shrink-0 items-center" aria-label="24 Plus Media, prima pagină">
      <img src="/logo.webp" alt="24 Plus Media" width="440" height="271" class="h-[54px] w-auto rounded-[10px]" />
    </a>

    <nav class="hidden items-center gap-7 text-[15px] font-semibold lg:flex" aria-label="Principal">
      <div class="group relative">
        <a href="/servicii" class:list={['block py-7 hover:text-brand-dark', path.startsWith('/servicii') && 'text-brand-dark']}>Servicii</a>
        <div class="absolute -left-6 top-full hidden w-[44rem] rounded-2xl border border-line bg-paper p-6 shadow-xl group-focus-within:block group-hover:block">
          <div class="grid grid-cols-2 gap-6">
            {categories.map((c, i) => (
              <div>
                <a href={`/servicii/${c.slug}`} class="flex items-baseline gap-2 font-extrabold hover:text-brand-dark"><span class="font-display text-xl text-brand-dark [font-stretch:78%]">{String(i + 1).padStart(2, '0')}</span>{c.title} →</a>
                <ul class="mt-2 space-y-1 text-sm font-medium text-mute">
                  {servicesIn(c.slug).map((s) => <li><a href={serviceUrl(s)} class="hover:text-ink hover:underline">{s.title}</a></li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
      {links.map((l) => <a href={l.href} class:list={['py-7 hover:text-brand-dark', path.startsWith(l.href) && 'text-brand-dark']}>{l.label}</a>)}
    </nav>

    <div class="flex items-center gap-4">
      <a href={site.phoneHref} class="hidden items-center gap-2 font-bold hover:text-brand-dark xl:inline-flex">
        <svg aria-hidden="true" class="size-4 text-brand-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>{site.phone}
      </a>
      <a href="/contact#oferta" class="btn btn-primary max-sm:hidden">Cere ofertă →</a>
      <details class="lg:hidden">
        <summary class="flex size-12 cursor-pointer list-none items-center justify-center rounded-xl border-[1.5px] border-ink" aria-label="Meniu">
          <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <div class="absolute inset-x-0 top-[78px] max-h-[80vh] overflow-y-auto border-b border-line bg-paper px-4 pb-6 sm:px-8">
          <a href="/servicii" class="block py-3 font-extrabold">Toate serviciile</a>
          {categories.map((c) => <a href={`/servicii/${c.slug}`} class="block border-t border-line py-3 text-mute hover:text-ink">{c.title}</a>)}
          {links.map((l) => <a href={l.href} class="block border-t border-line py-3 font-extrabold hover:text-brand-dark">{l.label}</a>)}
          <a href="/contact#oferta" class="btn btn-primary mt-3 w-full">Cere ofertă →</a>
          <a href={site.phoneHref} class="btn btn-outline mt-2 w-full">{site.phone}</a>
        </div>
      </details>
    </div>
  </div>
</header>
