---
import '../styles/global.css';
interface Props { title: string }
const { title } = Astro.props;
const user = Astro.locals.user;
const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');
const nav = [
  ['/admin', 'Panou'], ['/admin/cereri', 'Cereri ofertă'], ['/admin/servicii', 'Servicii'], ['/admin/portofoliu', 'Portofoliu'],
  ['/admin/clienti', 'Clienți'], ['/admin/testimoniale', 'Testimoniale'], ['/admin/setari', 'Setări'],
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · Administrare 24plus</title>
    <script src="/admin.js" defer></script>
    <link rel="icon" href="/favicon.png" />
  </head>
  <body class="bg-white">
    <div class="min-h-screen md:grid md:grid-cols-[14rem_1fr]">
      <aside class="bg-charcoal p-4 text-white md:sticky md:top-0 md:h-screen">
        <a href="/admin" class="flex items-center gap-2"><img src="/logo.webp" alt="24 Plus" class="h-10 w-auto" /><span class="text-xs font-bold uppercase tracking-widest text-white/60">Admin</span></a>
        {user && (
          <nav class="mt-5 flex flex-wrap gap-1 md:flex-col" aria-label="Administrare">
            {nav.map(([href, label]) => (
              <a href={href} class:list={['rounded-md px-3 py-2 text-sm font-semibold hover:bg-white/10', (href === '/admin' ? path === '/admin' : path.startsWith(href)) && 'bg-white/10 text-brand']}>{label}</a>
            ))}
            <a href="/" target="_blank" class="rounded-md px-3 py-2 text-sm text-white/70 hover:bg-white/10">Vezi site-ul ↗</a>
            <form method="post" action="/admin/logout" class="md:mt-6"><button class="w-full rounded-md px-3 py-2 text-left text-sm text-white/70 hover:bg-white/10">Ieșire ({user.name})</button></form>
          </nav>
        )}
      </aside>
      <main class="min-w-0 p-5 sm:p-8">
        <h1 class="display text-4xl">{title}</h1>
        {ok && <p role="status" class="mt-4 border-2 border-brand bg-brand-tint px-4 py-3 text-sm font-bold">{ok}</p>}
        {err && <p role="alert" class="mt-4 border-2 border-ink bg-white px-4 py-3 text-sm font-extrabold">{err}</p>}
        <div class="mt-6"><slot /></div>
      </main>
    </div>
  </body>
</html>
