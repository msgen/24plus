# Where the CMS keeps its JSON files and uploaded images. BACK THIS FOLDER UP.
DATA_DIR=./data
SITE_URL=https://24plus.ro
HOST=0.0.0.0
PORT=4321

# Optional: e-mail notification for each quote request (requests are always stored in the admin).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=contact@24plus.ro
MAIL_FROM=

# Optional; auto-generated into DATA_DIR/.secret when empty.
SESSION_SECRET=
# Set to 1 only for local http:// testing (cookies are Secure in production).
INSECURE_COOKIES=
