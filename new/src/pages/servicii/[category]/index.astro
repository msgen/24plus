---
import Base from '../../../layouts/Base.astro';
import ServiceCard from '../../../components/ServiceCard.astro';
import { getCategories, servicesIn } from '../../../lib/content';
const c = getCategories().find((x) => x.slug === Astro.params.category);
if (!c) return Astro.rewrite('/404');
---
<Base title={c.title} description={c.blurb}>
  <div class="container-x pt-12">
    <nav class="text-sm text-mute" aria-label="Breadcrumb"><a href="/servicii" class="hover:underline">Servicii</a> / {c.title}</nav>
    <h1 class="mt-3 text-4xl sm:text-5xl">{c.title}</h1>
    <p class="mt-3 max-w-2xl text-lg text-mute">{c.blurb}</p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {servicesIn(c.slug).map((s) => <ServiceCard service={s} />)}
    </div>
  </div>
</Base>
