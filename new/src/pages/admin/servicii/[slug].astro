---
import Admin from '../../../layouts/Admin.astro';
import { read, update } from '../../../lib/store';
import { str, bool, msg } from '../../../lib/admin';

const slug = Astro.params.slug!;
const found = read('services').find((s) => s.slug === slug);
if (!found) return Astro.redirect(msg('/admin/servicii', 'Serviciul nu există.', 'err'));

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  if (str(f, 'action') === 'delete') {
    update('services', (s) => s.filter((x) => x.slug !== slug));
    return Astro.redirect(msg('/admin/servicii', 'Serviciu șters.'));
  }
  const category = str(f, 'category');
  const paragraphs = str(f, 'paragraphs', 8000).split(/\n\s*\n/).map((p) => p.replace(/\s+/g, ' ').trim()).filter(Boolean);
  const publish = bool(f, 'published');
  if (publish && paragraphs.length === 0) return Astro.redirect(msg(Astro.url.pathname, 'Adaugă text înainte de publicare.', 'err'));
  update('services', (all) => {
    const s = all.find((x) => x.slug === slug)!;
    s.title = str(f, 'title', 100) || s.title;
    if (read('categories').some((c) => c.slug === category)) s.category = category;
    s.excerpt = str(f, 'excerpt', 200);
    s.paragraphs = paragraphs;
    s.order = Number(f.get('order')) || s.order;
    s.hidden = !publish;
    s.needsReview = false; // saved by a human = reviewed
  });
  return Astro.redirect(msg(Astro.url.pathname, 'Salvat.'));
}
const s = found;
const categories = read('categories');
---
<Admin title={s.title}>
  <p class="mb-4 text-sm"><a href="/admin/servicii" class="text-brand-dark hover:underline">← Toate serviciile</a>{!s.hidden && <> · <a class="text-brand-dark hover:underline" href={`/servicii/${s.category}/${s.slug}`} target="_blank">Vezi pe site ↗</a></>}</p>
  {s.needsReview && <p class="mb-4 rounded-lg bg-orange-50 px-4 py-3 text-sm font-semibold text-orange-800">Textul a fost rescris automat și nu a fost verificat. Citește-l, corectează-l și apasă Salvează.</p>}
  <form method="post" class="card max-w-3xl space-y-4">
    <label class="label">Titlu<input class="field" name="title" value={s.title} required maxlength="100" /></label>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="label">Categorie<select class="field" name="category">{categories.map((c) => <option value={c.slug} selected={c.slug === s.category}>{c.title}</option>)}</select></label>
      <label class="label">Ordine în listă<input class="field" name="order" type="number" value={s.order} /></label>
    </div>
    <label class="label">Descriere scurtă (apare pe carduri și în Google, max. 200 caractere)<input class="field" name="excerpt" value={s.excerpt} maxlength="200" /></label>
    <label class="label">Text (separă paragrafele cu un rând gol)<textarea class="field" name="paragraphs" rows="10">{s.paragraphs.join('\n\n')}</textarea></label>
    <label class="flex items-center gap-2 text-sm font-semibold"><input type="checkbox" name="published" checked={!s.hidden} class="h-4 w-4" /> Publicat pe site</label>
    <div class="flex flex-wrap gap-3">
      <button class="btn btn-primary btn-sm">Salvează</button>
      <button name="action" value="delete" class="btn btn-danger btn-sm" formnovalidate onclick="return confirm('Ștergi definitiv serviciul?')">Șterge serviciul</button>
    </div>
  </form>
  <p class="mt-4 text-sm text-mute">Fotografiile serviciului se adaugă din <a class="text-brand-dark hover:underline" href={`/admin/portofoliu?service=${s.slug}`}>Portofoliu</a>.</p>
</Admin>
