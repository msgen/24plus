---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina nu a fost găsită" noindex>
  <div class="container-x py-24 text-center">
    <p class="eyebrow">Eroare 404</p>
    <h1 class="mt-2 text-5xl">Pagina nu există</h1>
    <p class="mt-3 text-mute">Poate a fost mutată. Încearcă de la prima pagină sau din lista de servicii.</p>
    <div class="mt-6 flex justify-center gap-3"><a href="/" class="btn btn-primary">Prima pagină</a><a href="/servicii" class="btn btn-dark">Servicii</a></div>
  </div>
</Base>
