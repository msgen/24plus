---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { categories, servicesIn, serviceBySlug, clients, projects, site } from '../lib/content';

const featured = ['litere-volumetrice', 'casete-luminoase', 'personalizari-auto', 'decorari-geamuri-si-vitrine', 'totem', 'mese-candybar']
  .map(serviceBySlug).filter((s) => !!s);
const strip = projects.filter((_, i) => i % 3 === 0).slice(0, 12);
---
<Base title={site.name}>
  <section class="relative isolate overflow-hidden bg-charcoal text-white">
    <img src="/img/hero.webp" alt="" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-70" fetchpriority="high" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-charcoal/95 via-charcoal/60 to-transparent"></div>
    <div class="container-x py-24 sm:py-32">
      <p class="eyebrow eyebrow-light">Producție publicitară · Râmnicu Vâlcea</p>
      <h1 class="mt-4 max-w-3xl text-4xl sm:text-6xl">Brandul tău, văzut de departe.</h1>
      <p class="mt-5 max-w-xl text-lg text-white/80">De la design la montaj: litere volumetrice, firme luminoase, personalizări auto, print mare și digital, obiecte promoționale.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact#oferta" class="btn btn-primary">Cere ofertă</a>
        <a href="/portofoliu" class="btn btn-ghost">Vezi portofoliul</a>
      </div>
    </div>
  </section>

  <section class="container-x relative z-10 -mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {categories.map((c, i) => (
      <a href={`/servicii/${c.slug}`} class="rounded-2xl bg-white p-5 shadow-lg ring-1 ring-line transition hover:-translate-y-1">
        <span class="text-xs font-bold text-brand-dark">{String(i + 1).padStart(2, '0')}</span>
        <h2 class="mt-1 text-lg">{c.title}</h2>
        <p class="mt-1 text-sm text-mute">{c.blurb}</p>
        <p class="mt-3 text-xs font-bold text-mute">{servicesIn(c.slug).length} servicii →</p>
      </a>
    ))}
  </section>

  <section class="container-x mt-20 grid gap-10 lg:grid-cols-2">
    <div>
      <p class="eyebrow">Despre noi</p>
      <h2 class="mt-2 text-3xl sm:text-4xl">Soluții complete, la prețuri corecte.</h2>
    </div>
    <div class="space-y-4 text-mute">
      <p><strong class="text-ink">24 Plus Media</strong> este o firmă de producție publicitară, specializată în materiale publicitare, decorări și personalizări auto, vitrine, spații comerciale, semnalistică de interior și exterior, print de mari dimensiuni, tipar digital și obiecte promoționale.</p>
      <p><strong class="text-ink">Echipa noastră</strong> îți oferă soluții complete: design, consiliere în alegerea materialelor, producție, asamblare, montaj și logistică.</p>
      <p>Ne adaptăm cerințelor tale, reducem la minimum timpii de livrare și lucrăm cu soluții de calitate la prețuri corecte.</p>
    </div>
  </section>

  <section class="container-x mt-20">
    <div class="flex items-end justify-between gap-4">
      <div><p class="eyebrow">Ce facem</p><h2 class="mt-2 text-3xl sm:text-4xl">Servicii populare</h2></div>
      <a href="/servicii" class="hidden text-sm font-bold text-brand-dark hover:underline sm:block">Toate serviciile →</a>
    </div>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((s) => <ServiceCard service={s!} />)}
    </div>
  </section>

  <section class="mt-20 bg-charcoal py-16 text-white">
    <div class="container-x">
      <div class="flex items-end justify-between gap-4">
        <div><p class="eyebrow eyebrow-light">Lucrări recente</p><h2 class="mt-2 text-3xl sm:text-4xl">Din portofoliul nostru</h2></div>
        <a href="/portofoliu" class="text-sm font-bold text-brand hover:underline">Vezi tot →</a>
      </div>
      <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {strip.map((p) => <li class="overflow-hidden rounded-xl"><a href="/portofoliu"><img src={p.thumb} alt="Lucrare 24 Plus Media" loading="lazy" width="640" height="480" class="aspect-[4/3] w-full object-cover transition duration-500 hover:scale-105" /></a></li>)}
      </ul>
    </div>
  </section>

  <section class="container-x mt-20">
    <p class="eyebrow">Încredere</p>
    <h2 class="mt-2 text-3xl sm:text-4xl">Au lucrat cu noi</h2>
    <ul class="mt-6 flex flex-wrap gap-2">
      {clients.map((c) => <li class="rounded-full bg-white px-4 py-2 text-sm font-semibold ring-1 ring-line">{c.name}</li>)}
    </ul>
  </section>

  <section class="container-x mt-20">
    <div class="rounded-3xl bg-brand p-8 text-charcoal sm:p-12">
      <h2 class="text-3xl sm:text-4xl">Ai un proiect în minte?</h2>
      <p class="mt-2 max-w-xl font-medium">Spune-ne ce ai nevoie și revenim cu o ofertă. Ne poți suna direct la {site.phone}.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/contact#oferta" class="btn btn-dark">Cere ofertă</a>
        <a href={site.phoneHref} class="btn border border-charcoal/30 hover:bg-charcoal/10">{site.phone}</a>
      </div>
    </div>
  </section>
</Base>
